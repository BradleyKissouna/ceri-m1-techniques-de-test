<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <module name="TreeWalker">
        <!-- Vérifie les conventions de nommage des classes. -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Vérifie les conventions de nommage des variables locales. -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Vérifie les conventions de nommage des méthodes. -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Vérifie qu'il n'y a pas de lignes de code trop complexes. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>

         <!-- Vérifie la présence des Javadocs pour les méthodes -->
        <module name="JavadocMethod">
            <property name="scope" value="public"/>
        </module>

        <!-- Vérifie la présence des Javadocs pour les types -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>
    </module>

    <!-- Vérifie qu'il y a une ligne vide à la fin du fichier. -->
    <module name="NewlineAtEndOfFile"/>
</module>
