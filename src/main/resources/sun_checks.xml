<?xml version="1.0"?>
<!DOCTYPE checkstyle PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.sourceforge.io/dtds/configuration_1_3.dtd">
<checkstyle>
    <module name="Checker">
        <module name="TreeWalker">
            <module name="JavadocStyle"/>
            <module name="Indentation">
                <property name="basicOffset" value="4"/>
                <property name="tabWidth" value="4"/>
            </module>
            <module name="LineLength">
                <property name="max" value="120"/>
            </module>
        </module>
    </module>
</checkstyle>
